# Files in this repo that must never be served on the website.
# wrangler.jsonc serves the whole repo folder, so anything not hidden here
# is public. Same syntax as .gitignore; a leading "/" means top level only.
# Checked by tests/check_public_files.sh.

# Every dot-file and dot-folder: .git, .gitignore, .assetsignore, .github,
# .claude, .wrangler (made by wrangler dev), .env, .dev.vars, .npmrc,
# .DS_Store, editor settings. .well-known stays public (e.g. security.txt).
.*
!/.well-known

# Worker settings, tests, notes and packages (wrangler dev makes node_modules)
/wrangler.*
/tests
# The events build script and its last good copy of the feed (Q09)
/scripts
/data
*.md
/package*.json
node_modules
